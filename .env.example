# Cloud features are OPTIONAL. Leave this file unused and the meter runs fully
# offline: capture, overlay, history, and detail views all work without it.
#
# Filling these in enables the upstream-style account system, the DPS
# leaderboard upload, and avatar storage -- all of which need a Supabase project
# with NOIA2's schema (dps_leaderboard_v2, aion2_dps_class_box_stats_v2,
# submit_dps_leaderboard_v2, get_membership_status, activate_membership).
#
# Upstream's own credentials are NOT public, so these stay empty unless you
# stand up your own backend.
#
# Copy to `.env` to activate.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
